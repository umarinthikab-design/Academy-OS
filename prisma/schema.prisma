// Touchline database schema
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────

enum Role {
  ADMIN
  CLUB_MANAGER
  HEAD_COACH
  ASSISTANT_COACH
  PARENT
}

enum Designation {
  HEAD
  ASSISTANT
}

enum DrillStatus {
  PENDING
  APPROVED
}

enum RequestType {
  SKILL_UPDATE
  DRILL_ADD
  DRILL_EDIT
  SESSION_SHARE
  ATTENDANCE_CONFIRM
  SCHEDULE_CREATE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlayerAttendanceStatus {
  NO_RESPONSE
  ATTENDING
  NOT_ATTENDING
  ATTENDED
  ABSENT
}

enum CoachAttendanceStatus {
  NOT_YET
  CHECKED_IN
  ABSENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PlayerStatus {
  ACTIVE
  INJURED
  SUSPENDED
  INACTIVE
}

// Self-service pre-session RSVP. This is separate from CoachAttendance
// ("did you attend" - checked in after the session) - this answers "will you
// attend" ahead of time, with no approval chain.
enum CoachConfirmationStatus {
  PENDING
  CONFIRMED
  DECLINED
}

// ── People ───────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String // hashed - never store plain text
  name           String
  role           Role
  // Bump this to invalidate every existing session for this user without
  // rotating SESSION_SECRET (which would log everyone out). The value is
  // baked into the JWT at login time and checked against this column on
  // every request in getSession().
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())

  // Profile photo (URL for now - same approach as Player.photoUrl). Optional
  // so admins and anyone without a hosted avatar can skip it.
  photoUrl String?

  // UI theme preference. Persisted per user so the whole app renders in the
  // same mode across devices.
  theme String @default("light")

  // When true the user must change their password before using the app.
  // Set when an admin creates the account or resets the password; cleared
  // once they complete a password change.
  mustChangePassword Boolean @default(false)

  // Set when a club manager / admin archives this staff member. Null =
  // active. Moved from Coach so it covers users with no Coach row (admins,
  // club managers) too. Historical data (drills, sessions, attendance) is
  // never touched by archiving - only login access and active-selection
  // visibility.
  archivedAt DateTime?

  coach        Coach?
  parent       Parent?
  activityLogs ActivityLog[]
  approvalMessages ApprovalMessage[]
  pushSubscriptions PushSubscription[]
}

// One row per subscribed browser/device (a user can have several - phone,
// laptop, etc). `endpoint` is the push service's unique URL for that
// subscription, so it's the natural upsert key: a device re-subscribing
// (e.g. after clearing site data) gets its keys refreshed in place rather
// than accumulating a duplicate row.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Coach {
  id          String      @id @default(cuid())
  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  designation Designation
  dateJoined  DateTime    @default(now())

  // Gender is required at creation time in the UI (never a free-form string);
  // stored nullable so pre-existing rows without it keep working.
  gender Gender?

  // Permission overrides - only meaningful for HEAD_COACH designation.
  // Admin always has full access; assistant coaches always queue requests
  // regardless of these flags.
  canEditRoster       Boolean @default(false)
  canEditDrills       Boolean @default(false)
  canApproveRequests  Boolean @default(false)
  canEditSchedule     Boolean @default(false)
  canEditLocations    Boolean @default(false)
  canEditAgeGroups    Boolean @default(false)

  primaryFocus       AgeGroup[] @relation("CoachPrimaryFocus")
  mainBatches        Batch[]    @relation("BatchMainCoaches")
  supportingBatches  Batch[]    @relation("BatchSupportingCoaches")

  headSessions      ScheduledSession[] @relation("HeadCoachSessions")
  assistantSessions ScheduledSession[] @relation("AssistantCoachSessions")

  sessionConfirmations SessionCoachConfirmation[]

  createdDrills   Drill[]         @relation("DrillCreatedBy")
  drillFeedback   DrillFeedback[]
  createdSessions Session[]       @relation("SessionCreatedBy")
  notes           Note[]
  coachAttendance CoachAttendance[]

  requestsMade     ApprovalRequest[] @relation("RequestedBy")
  requestsResolved ApprovalRequest[] @relation("ResolvedBy")
}

model Parent {
  id      String   @id @default(cuid())
  userId  String   @unique
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  players Player[] @relation("ParentPlayers")
}

// ── Structure (admin-managed rosters) ───────────────────

// Admin-managed category options for AgeGroup (e.g. "Little League",
// "Junior Varsity"). Was a fixed enum; converted to a real model so an
// admin can rename, add, or remove categories without a code change.
model AgeGroupCategoryOption {
  id        String     @id @default(cuid())
  name      String     @unique
  sortOrder Int        @default(0)
  ageGroups AgeGroup[]
}

model AgeGroup {
  id         String                 @id @default(cuid())
  name       String                 @unique // e.g. "U9"
  categoryId String
  category   AgeGroupCategoryOption @relation(fields: [categoryId], references: [id])
  sortOrder  Int                    @default(0)

  coaches           Coach[]            @relation("CoachPrimaryFocus")
  batches           Batch[]
  drills            Drill[]            @relation("DrillAgeGroups")
  scheduledSessions ScheduledSession[]
}

model Location {
  id                String             @id @default(cuid())
  name              String             @unique
  address           String?
  scheduledSessions ScheduledSession[]
}

model Batch {
  id          String   @id @default(cuid())
  name        String
  ageGroupId  String
  ageGroup    AgeGroup @relation(fields: [ageGroupId], references: [id])
  mainCoaches Coach[]  @relation("BatchMainCoaches")
  // Support staff - separate from the main coaches who lead the batch.
  // Stored on the same join table shape as mainCoaches so a batch can have
  // both a primary lead and assistants.
  supportingCoaches Coach[] @relation("BatchSupportingCoaches")
  players           Player[] @relation("PlayerBatches")

  scheduledSessions ScheduledSession[]
}

model Player {
  id          String   @id @default(cuid())
  name        String
  dateOfBirth DateTime
  // Mirrors Coach.dateJoined - set automatically on creation. Added for the
  // Squad date-joined filter and the player detail page.
  dateJoined  DateTime @default(now())

  // Playing position. Free-form strings would scatter data ("GK" vs
  // "Goalkeeper"), so the UI constrains to a fixed set. Stored as a plain
  // String with a default rather than an enum so new positions can be added
  // without a migration; the canonical list lives in lib/skills.ts.
  position String @default("Unassigned (Default)")

  // Profile expansion (Release 1 §8). photoUrl is just a URL field for now -
  // actual file upload needs a storage provider decision (Vercel Blob, S3,
  // etc.), so the UI falls back to a placeholder avatar until then.
  // Emergency/medical info is safety-relevant, so it's readable by any
  // coach with squad view access (not gated behind edit permissions).
  photoUrl               String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  medicalNotes           String?

  // Gender is required at creation time in the UI; stored nullable so
  // pre-existing rows without it keep working.
  gender Gender?

  // Availability flag: a coach marks a player ACTIVE, INJURED, SUSPENDED, or
  // INACTIVE straight from the squad view, so availability is visible
  // everywhere a player card appears (no separate status page to keep in
  // sync).
  status PlayerStatus @default(ACTIVE)
  // Bumped whenever `status` changes, so the UI can nudge coaches when a
  // non-ACTIVE status has gone stale (see PlayerStatusBadge). Defaults to
  // creation time so pre-existing rows read as "never flagged".
  statusUpdatedAt DateTime @default(now())

  batches Batch[]  @relation("PlayerBatches")
  parents Parent[] @relation("ParentPlayers")

  skills        PlayerSkill[]
  skillHistory  PlayerSkillHistory[]
  attendance    PlayerAttendance[]
  notes         Note[]
}

// Admin-managed skill rating dimensions, grouped by age band. `band` matches
// one of the three fixed band labels in lib/skills.ts (SKILL_BAND_META) -
// the band age ranges themselves stay code-defined, only the skill lists
// within each band are admin-editable here. A skill name can appear in more
// than one band as separate rows (e.g. "Shooting" is both a Skill
// Acquisition and a Youth Development skill today) - hence the unique
// constraint is on (name, band), not name alone.
//
// Deliberately NOT a foreign key from PlayerSkill/PlayerSkillHistory -
// skill history is append-only, and forcing a rename here to cascade
// through years of history would be more disruptive than useful. This
// table only drives what's offered as an editable dimension and what a
// newly-created (or newly in-band) player gets a baseline row for.
model SkillDefinition {
  id        String @id @default(cuid())
  name      String
  band      String
  sortOrder Int    @default(0)

  @@unique([name, band])
}

model PlayerSkill {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  skillName String
  value     Int
  // Whether this skill is shown on the player's rating card. Customizing a
  // player's skills toggles this rather than deleting the row, so the value
  // and its history survive being hidden. New players get rows for their
  // age-band skills (all active); older players' legacy skills are kept
  // active too so nothing disappears on upgrade.
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([playerId, skillName])
}

// Append-only history of skill ratings. PlayerSkill.value is overwritten in
// place on each update, so without this there'd be no record of how a
// player's ratings changed over time. A row is inserted here from
// updateSkill on every change.
model PlayerSkillHistory {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  skillName  String
  value      Int
  recordedAt DateTime @default(now())
}

model Note {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  coachId   String
  coach     Coach    @relation(fields: [coachId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

// ── Drills & Sessions ────────────────────────────────────

// Admin-managed drill categories (e.g. "Passing", "Shooting"). Was a
// hardcoded constant in app/drills/page.tsx; converted to a real model so
// an admin can rename, add, or remove categories without a code change and
// so category names can't drift into typo'd duplicates.
model DrillCategory {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0)
  drills    Drill[]
}

model Drill {
  id          String        @id @default(cuid())
  name        String
  categoryId  String
  category    DrillCategory @relation(fields: [categoryId], references: [id])
  duration    Int // minutes
  playerRange String? // e.g. "4-12"
  description String?
  status      DrillStatus @default(APPROVED)

  // Nullable so admins and club managers (who have no Coach row) can author
  // drills too. Coaches keep their identity here.
  createdById String?
  createdBy   Coach? @relation("DrillCreatedBy", fields: [createdById], references: [id])

  // Soft-archive for admin / club manager drill cleanup. Archived drills are
  // hidden from the library and the session-plan drill picker, but history
  // (photos, feedback, session plans using them) is untouched.
  archivedAt DateTime?

  ageGroups AgeGroup[] @relation("DrillAgeGroups")

  // Drill photos - one or more per drill (setup diagram, demonstration shots,
  // etc). Stored as small base64 data URLs (same approach as Player.photoUrl)
  // until a storage provider decision is made.
  photos DrillPhoto[]

  feedback      DrillFeedback[]
  sessionDrills SessionDrill[]

  createdAt DateTime @default(now())
}

// A single photo attached to a drill. Multiple allowed, shown in the order
// they were attached.
model DrillPhoto {
  id        String @id @default(cuid())
  drillId   String
  drill     Drill  @relation(fields: [drillId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int    @default(0)
}

// The back-and-forth revision thread on a pending drill suggestion.
model DrillFeedback {
  id        String   @id @default(cuid())
  drillId   String
  drill     Drill    @relation(fields: [drillId], references: [id], onDelete: Cascade)
  authorId  String
  author    Coach    @relation(fields: [authorId], references: [id])
  message   String
  createdAt DateTime @default(now())
}

// A drill plan - separate from the calendar slot (ScheduledSession).
model Session {
  id          String         @id @default(cuid())
  name        String
  createdById String
  createdBy   Coach          @relation("SessionCreatedBy", fields: [createdById], references: [id])
  isPrivate   Boolean        @default(true)
  shareStatus RequestStatus?
  createdAt   DateTime       @default(now())

  drills            SessionDrill[]
  scheduledSessions ScheduledSession[]
}

model SessionDrill {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  drillId   String
  drill     Drill   @relation(fields: [drillId], references: [id])
  order     Int
}

// The calendar slot - date, time, location, coaches, recurrence.
model ScheduledSession {
  id              String   @id @default(cuid())
  date            DateTime
  startTime       String // "14:00"
  durationMinutes Int

  ageGroupId String
  ageGroup   AgeGroup @relation(fields: [ageGroupId], references: [id])
  batchId    String?
  batch      Batch?   @relation(fields: [batchId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  headCoaches      Coach[] @relation("HeadCoachSessions")
  assistantCoaches Coach[] @relation("AssistantCoachSessions")

  sessionId String? // optional link to a drill plan
  session   Session? @relation(fields: [sessionId], references: [id])

  recurring         Boolean @default(false)
  recurrenceGroupId String? // groups all instances generated from one recurring rule

  status String @default("scheduled") // scheduled | completed | cancelled

  // Set when attendance review for this session is finished. Sessions whose
  // date has passed but have no resolvedAt still need their attendance
  // confirmed. Kept separate from `status` because a session can be marked
  // "completed" without its attendance being reviewed, and vice versa.
  resolvedAt DateTime?

  playerAttendance PlayerAttendance[]
  coachAttendance  CoachAttendance[]

  // Pre-session RSVP rows, one per assigned coach.
  coachConfirmations SessionCoachConfirmation[]

  createdAt DateTime @default(now())
}

model PlayerAttendance {
  id                 String                  @id @default(cuid())
  playerId           String
  player             Player                  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  scheduledSessionId String
  scheduledSession   ScheduledSession        @relation(fields: [scheduledSessionId], references: [id], onDelete: Cascade)
  status             PlayerAttendanceStatus  @default(NO_RESPONSE)
  deadline           DateTime // 6 hours before session start
  confirmedAt        DateTime?

  @@unique([playerId, scheduledSessionId])
}

model CoachAttendance {
  id                 String                 @id @default(cuid())
  coachId            String
  coach              Coach                  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  scheduledSessionId String
  scheduledSession   ScheduledSession       @relation(fields: [scheduledSessionId], references: [id], onDelete: Cascade)
  status             CoachAttendanceStatus  @default(NOT_YET)
  method             String? // "self" | "admin_override"
  confirmedAt        DateTime?

  @@unique([coachId, scheduledSessionId])
}

// Self-service pre-session RSVP: one row per assigned coach per session.
// Created PENDING when the session is scheduled; the coach confirms or
// declines from their dashboard. Distinct from CoachAttendance (post-session
// check-in) - this is "will you attend", ahead of time, no approval chain.
model SessionCoachConfirmation {
  id                 String                   @id @default(cuid())
  scheduledSessionId String
  scheduledSession   ScheduledSession         @relation(fields: [scheduledSessionId], references: [id], onDelete: Cascade)
  coachId            String
  coach              Coach                    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  status             CoachConfirmationStatus  @default(PENDING)
  confirmedAt        DateTime?
  createdAt          DateTime                 @default(now())
  // Last time a push reminder was sent for this specific still-pending
  // confirmation. Lets the reminder cron (hourly) skip anyone it already
  // nudged recently instead of re-notifying every single run.
  lastRemindedAt     DateTime?

  @@unique([scheduledSessionId, coachId])
}

// Academy-wide (club-wide) configuration, distinct from the per-user
// app/settings page. A singleton row - only one should exist, enforced in
// the update action (Prisma has no clean "exactly one row" constraint).
model AcademySettings {
  id                            String  @id @default(cuid())
  // Master switch for the pre-session confirmation feature.
  preSessionConfirmationEnabled Boolean @default(true)
  // Whether club managers can author drills into the library like coaches.
  // Controlled by the admin on the Club Settings page.
  clubManagersCanAuthorDrills   Boolean @default(true)
  // When a session's start is this many hours away it appears in the
  // "Confirm your upcoming sessions" section.
  confirmationWindowHours       Int     @default(72)
  // Within this many hours of start, an unanswered confirmation escalates
  // to the "priority" treatment.
  priorityWindowHours           Int     @default(48)
  // Academy name shown prominently across the app (login screen, sidebar,
  // mobile top bar, dashboard welcome). The "system name" stays Touchline;
  // this is the club's own branding on top of it.
  academyName String @default("My Academy")
  // Academy logo - plain URL field for now (same deferred-decision pattern as
  // Player.photoUrl); no upload flow wired up yet. Falls back to the text
  // academyName wherever a logo is absent.
  logoUrl     String?
}

// ── Approvals & accountability ──────────────────────────

model ApprovalRequest {
  id            String        @id @default(cuid())
  type          RequestType
  payload       Json // flexible - shape depends on `type`
  requestedById String
  requestedBy   Coach         @relation("RequestedBy", fields: [requestedById], references: [id])
  status        RequestStatus @default(PENDING)
  resolvedById  String?
  resolvedBy    Coach?        @relation("ResolvedBy", fields: [resolvedById], references: [id])
  createdAt     DateTime      @default(now())
  resolvedAt    DateTime?

  messages ApprovalMessage[]
}

// The back-and-forth thread on a request: approvers suggest changes, the
// requester replies, until it's approved or rejected. Mirrors DrillFeedback
// but on ApprovalRequest so every request type gets the conversation.
// Authors are Users (not Coaches) so admins - who have no Coach row - can
// take part in the conversation too.
model ApprovalMessage {
  id               String         @id @default(cuid())
  approvalRequestId String
  approvalRequest  ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  authorId         String
  author           User           @relation(fields: [authorId], references: [id])
  message          String
  createdAt        DateTime       @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String // e.g. "created_drill", "approved_request"
  entityType String // e.g. "Drill", "ScheduledSession"
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
}

// Failed/successful login attempts, keyed by email. Used for brute-force
// rate limiting on the login form - a DB-backed counter because the app
// runs on Vercel serverless, where in-memory state doesn't survive between
// cold starts (and multiple instances would each have their own counter).
//
// ipAddress backs a second, broader rate-limit layer keyed by source IP
// instead of email - the per-email limiter alone doesn't stop someone
// spraying one guessed password across many different email addresses,
// since no single email ever crosses its own failure threshold.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}
