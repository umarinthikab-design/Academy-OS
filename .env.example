# Copy this file to .env and fill in your real values.
# Get DATABASE_URL from your Neon or Supabase project dashboard,
# under Connection String (use the "pooled" connection if offered).

DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# A random secret used to sign login sessions. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never share this value or commit it to git.
SESSION_SECRET="replace_this_with_a_generated_random_string"
