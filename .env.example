# Copy this file to .env and fill in your real values.
# Get DATABASE_URL from your Neon or Supabase project dashboard,
# under Connection String (use the "pooled" connection if offered).

DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Neon's direct (non-pooled) connection string, same database as
# DATABASE_URL. Only used by `prisma migrate deploy` during build - the
# advisory lock Prisma takes while migrating isn't properly supported over
# a pooled connection, which causes P1002 timeouts. The app itself keeps
# querying through DATABASE_URL (pooled) at runtime.
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# A random secret used to sign login sessions. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never share this value or commit it to git.
SESSION_SECRET="replace_this_with_a_generated_random_string"

# Web Push (VAPID). Generate once with:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must be the same value as VAPID_PUBLIC_KEY -
# it's exposed to the browser (Next.js only ships NEXT_PUBLIC_-prefixed vars
# to the client), VAPID_PRIVATE_KEY must never be.
VAPID_PUBLIC_KEY="replace_with_generated_public_key"
VAPID_PRIVATE_KEY="replace_with_generated_private_key"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace_with_generated_public_key"
# A real, monitored contact address - required by the Web Push protocol.
VAPID_SUBJECT="mailto:you@yourdomain.com"

# Verifies /api/cron/* requests actually come from Vercel Cron. Generate
# your own with the same command as SESSION_SECRET.
CRON_SECRET="replace_this_with_a_generated_random_string"

# Shared secret for the JotForm registration webhook
# (app/api/webhooks/jotform/route.ts). This is a public, unauthenticated
# endpoint by necessity - JotForm can't send our session cookie - so it's
# gated by this token instead, passed as a query param when configuring the
# webhook URL in JotForm: https://yourapp.com/api/webhooks/jotform?token=...
# Generate your own with the same command as SESSION_SECRET.
JOTFORM_WEBHOOK_SECRET="replace_with_your_jotform_webhook_secret"
